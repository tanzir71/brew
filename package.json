{
  "name": "brew-rss-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "start": "node dist/server/index.js",
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "review:m1": "tsx server/scripts/m1-exit-review.ts"
    ,"backup": "tsx server/scripts/backup.ts"
    ,"seed:big": "tsx server/scripts/seed-big.ts"
  },
  "dependencies": {
    "@fastify/static": "latest",
    "@mozilla/readability": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-virtual": "latest",
    "better-sqlite3": "latest",
    "dompurify": "latest",
    "drizzle-orm": "latest",
    "fastify": "latest",
    "linkedom": "latest",
    "node-cron": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
