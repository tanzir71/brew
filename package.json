{
  "name": "brew-rss-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch targets/node/src/index.ts\" \"vite --config packages/web/vite.config.ts\"",
    "start": "node dist/targets/node/src/index.js",
    "build": "vite build --config packages/web/vite.config.ts && tsc -p tsconfig.server.json && node scripts/copy-build-assets.mjs && node scripts/verify-node-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "review:m1": "tsx server/scripts/m1-exit-review.ts",
    "backup": "tsx server/scripts/backup.ts",
    "seed:big": "tsx server/scripts/seed-big.ts",
    "website:verify": "node scripts/verify-site.mjs",
    "website:browser": "node scripts/verify-website-browser.mjs"
  },
  "dependencies": {
    "@brew/core": "0.1.0",
    "@brew/db": "0.1.0",
    "@brew/node": "0.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "workspaces": [
    "packages/*",
    "targets/*"
  ]
}
