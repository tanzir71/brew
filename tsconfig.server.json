{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "targets/node/src/**/*.ts",
    "targets/cloudflare/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/db/src/**/*.ts",
    "packages/api/src/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
