# Node inbound mail is off unless a complete mode is configured.
# Copy to .env, fill only the chosen mode, and load it with Node 20.6+:
# NODE_ENV=production node --env-file=.env dist/targets/node/src/index.js
# npm start/dev do not automatically load .env; a service manager can supply env instead.
# Never commit .env. All addresses and secrets below are placeholders.

# BREW_INBOUND_MODE=imap
# BREW_INBOUND_ADDRESS=letters@your-domain.example
# BREW_IMAP_HOST=imap.your-provider.example
# BREW_IMAP_PORT=993
# BREW_IMAP_SECURITY=tls
# BREW_IMAP_USER=your-dedicated-mailbox
# BREW_IMAP_PASSWORD=your-mailbox-app-password
# BREW_IMAP_MAILBOX=INBOX
# BREW_IMAP_EVERY_SECONDS=60

# Or Postmark (private provider address or a domain you own):
# BREW_INBOUND_MODE=postmark
# BREW_INBOUND_ADDRESS=your-address@inbound.postmarkapp.com
# BREW_POSTMARK_USERNAME=brew
# BREW_POSTMARK_PASSWORD=replace-with-a-random-webhook-secret-at-least-16-characters

# Or Mailgun Routes:
# BREW_INBOUND_MODE=mailgun
# BREW_INBOUND_ADDRESS=letters@your-domain.example
# BREW_MAILGUN_SIGNING_KEY=your-http-webhook-signing-key

# Optional canonical origin for feeds/twins behind a reverse proxy:
# BREW_PUBLIC_URL=https://brew.your-domain.example

# Experimental in-page tools; also enable the browser switch in Agent access.
# Requires HTTPS or localhost. Off by default. See docs/webmcp.md.
# BREW_WEBMCP=1

# Optional outbound SMTP (requires BREW_PUBLIC_URL above):
# BREW_SMTP_HOST=smtp.your-provider.example
# BREW_SMTP_FROM=brew@your-domain.example
# BREW_SMTP_SECURITY=starttls
# BREW_SMTP_PORT=587
# BREW_SMTP_USER=your-smtp-user
# BREW_SMTP_PASSWORD=your-smtp-app-password
# For implicit TLS choose BREW_SMTP_SECURITY=tls and BREW_SMTP_PORT=465.
# Omit both USER and PASSWORD only for a trusted relay; encryption is still required.
# BREW_SMTP_SERVERNAME=smtp.your-provider.example

# Or optional Resend on Node (SMTP takes precedence when configured):
# Requires BREW_PUBLIC_URL; use a sending-only key for a verified sender domain.
# BREW_RESEND_API_KEY=re_replace_with_your_sending_key
# BREW_RESEND_FROM=brew@your-domain.example
